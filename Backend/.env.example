# ==============================================================================
# Phishing-EML-Analyzer — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your API keys.
# NEVER commit your actual '.env' file to version control.
#
#   cp .env.example .env
# ==============================================================================

# --- AI Semantic Engine ---
# OpenAI API key for LLM-powered semantic analysis (optional — falls back to rule-based)
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Dynamic Sandbox (URLScan.io) ---
# Register for a free API key at: https://urlscan.io/user/profile/
URLSCAN_API_KEY=your-urlscan-api-key-here

# --- OSINT (VirusTotal) ---
# Register for a free API key at: https://www.virustotal.com/gui/join-us
VT_API_KEY=your-virustotal-api-key-here
